# Accounts and sync. Inlined into the main process at build time by electron-vite.
# The sync server (server/ in this repo, deployed on Railway). Leave empty to build without accounts.
MAIN_VITE_API_URL=https://mayorly-api-production.up.railway.app
# Google OAuth client of type "Desktop app" from Google Cloud Console. The id is public.
MAIN_VITE_GOOGLE_CLIENT_ID=
# The desktop client's secret: not confidential for an installed app per Google, but keep it in .env.local.
MAIN_VITE_GOOGLE_CLIENT_SECRET=
