{
  "name": "mayorly-app",
  "productName": "Mayorly",
  "version": "0.1.0",
  "description": "Mayorly desktop app for Windows and macOS. A transparent focus HUD with continuous flows and superset rotation rules.",
  "author": "Shane Li",
  "private": true,
  "type": "module",
  "main": "out/main/index.js",
  "homepage": "https://github.com/shane1595042264/mayorly-app",
  "scripts": {
    "dev": "electron-vite dev",
    "web": "vite --config vite.web.config.ts",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "icon": "node scripts/make-icon.mjs",
    "dist": "electron-vite build && electron-builder --publish never",
    "dist:win": "electron-vite build && electron-builder --win --publish never",
    "dist:mac": "electron-vite build && electron-builder --mac --publish never",
    "dist:mas": "electron-vite build && electron-builder --mac mas --publish never",
    "ship:mac": "sh scripts/ship-mac.sh",
    "phone": "vite --config vite.phone.config.ts",
    "phone:build": "vite build --config vite.phone.config.ts",
    "ship:ios": "sh scripts/ship-ios.sh",
    "shot": "electron scripts/shot.cjs"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^1.2.0",
    "@capacitor/app": "8.1.2",
    "@capacitor/cli": "8.5.3",
    "@capacitor/core": "8.5.3",
    "@capacitor/filesystem": "8.1.5",
    "@capacitor/haptics": "8.0.2",
    "@capacitor/ios": "8.5.3",
    "@capacitor/keyboard": "8.0.6",
    "@capacitor/local-notifications": "8.3.1",
    "@capacitor/status-bar": "8.0.4",
    "@fontsource/barlow-condensed": "5.3.0",
    "@fontsource/geist-mono": "5.3.0",
    "@phosphor-icons/react": "2.1.10",
    "@types/node": "24.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "44.7.0",
    "electron-builder": "26.15.3",
    "electron-updater": "^6.8.11",
    "electron-vite": "5.0.0",
    "fflate": "0.8.3",
    "motion": "14.0.0",
    "node-ical": "^0.27.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "5.0.3"
  }
}
