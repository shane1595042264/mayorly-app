# Postgres. On Railway, reference the Postgres service: ${{Postgres.DATABASE_URL}}
DATABASE_URL=postgresql://user:password@localhost:5432/mayorly
# Signs the app's own session tokens. Any long random string.
JWT_SECRET=change-me
# Comma-separated Google OAuth client ids allowed to sign in (the desktop app's client).
GOOGLE_CLIENT_IDS=
PORT=8080
