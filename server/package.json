{
  "name": "mayorly-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Mayorly sync server: Google sign-in and one state document per account.",
  "scripts": {
    "dev": "node --watch --experimental-strip-types src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@hono/node-server": "1.19.6",
    "hono": "4.10.4",
    "ical-generator": "^11.1.3",
    "jose": "6.1.1",
    "pg": "8.16.3"
  },
  "devDependencies": {
    "@types/node": "24.19.1",
    "@types/pg": "8.15.5",
    "typescript": "5.9.3"
  }
}
